{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm",
      "deb",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../src/assets/licenses.json": "licenses.json"
    }
  },
  "productName": "vrc-social-manager",
  "mainBinaryName": "vrc-social-manager",
  "version": "1.0.0-beta.2",
  "identifier": "com.meronmks.vsm",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NUY2QzkyQUQzMEEwRDkKUldUWm9EQ3RrbXhmWkxQak51cG13T1l1QzJEMFFoTDRybnFyK3dIODJaalFnRERrYmdDbzNVckIK",
      "windows": {
        "installMode": "passive"
      },
      "dialog": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: vrcimg: http://vrcimg.localhost https://vrcimg.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob: vrcimg: http://vrcimg.localhost https://vrcimg.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws: wss:; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "desktop-capability",
        "android-capability"
      ]
    },
    "windows": [
      {
        "title": "vrc-social-manager",
        "width": 800,
        "height": 600
      }
    ]
  }
}
